# ─────────────────────────────────────────────────────────────────────────
# Khairiyat configuration
#
# Copy this file to `.env.local` (never commit that file).
# LEAVE EVERYTHING EMPTY TO RUN IN DEMO MODE: embedded database, mock calls,
# mock WhatsApp, mock email, mock payments. No accounts needed.
#
# A provider becomes "real" only when ALL of its keys are filled in.
# If you fill only some of them, the app refuses to start (on purpose),
# so a half-configured provider can never silently drop real alerts.
# ─────────────────────────────────────────────────────────────────────────

# development | test | production
APP_ENV=development
# Public address of the website (https:// in production)
APP_URL=http://localhost:3000
# Only for a public demo website: allow mock providers in production
ALLOW_DEMO_PROVIDERS_IN_PRODUCTION=

# ── Database ─────────────────────────────────────────────────────────────
# Empty = embedded demo database (data kept in .demo-data/).
# Production: Supabase pooler connection string (transaction mode, port 6543).
DATABASE_URL=

# ── Our own secrets (required in production; demo values are used locally) ─
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts sensitive fields such as health notes. Losing it = losing that data.
DATA_ENCRYPTION_KEY=
# Signs login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Protects the scheduler tick endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=
# Comma-separated emails that get the admin panel
ADMIN_EMAILS=

# ── Google sign-in (optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Voice: ElevenLabs Agents ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# twilio (phone number imported from Twilio) | sip_trunk (Plivo/Ozonetel/Tata via SIP)
ELEVENLABS_TELEPHONY=twilio

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
# e.g. Khairiyat <hello@yourdomain.in>  (needs a verified domain)
EMAIL_FROM=

# ── Payments (Razorpay) ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Monitoring (optional) ────────────────────────────────────────────────
SENTRY_DSN=
# Healthchecks.io ping URL: alerts you if the scheduler stops ticking
HEALTHCHECKS_PING_URL=

# ── Support (optional) ───────────────────────────────────────────────────
# Your WhatsApp support number in E.164, e.g. +9198XXXXXXXX
SUPPORT_WHATSAPP_NUMBER=
