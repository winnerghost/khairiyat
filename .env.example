# ─────────────────────────────────────────────────────────────────────────
# Khairiyat configuration
#
# Copy this file to `.env.local` (never commit that file).
# LEAVE EVERYTHING EMPTY TO RUN IN DEMO MODE: embedded database, mock calls,
# mock WhatsApp, mock email, mock payments. No accounts needed.
#
# A provider becomes "real" only when ALL of its keys are filled in.
# If you fill only some of them, the app refuses to start (on purpose),
# so a half-configured provider can never silently drop real alerts.
# ─────────────────────────────────────────────────────────────────────────

# development | test | demo | production
#   demo = the PUBLIC DEMO WEBSITE (e.g. khairiyat-demo.netlify.app): demo
#   logins and the demo room work, every provider must stay the mock (no real
#   calls or messages), and it needs real secrets, https and a shared database.
#   There is no background scheduler: the demo moves forward when someone visits.
APP_ENV=development
# Public address of the website (https:// in production and demo)
APP_URL=http://localhost:3000
# Escape hatch: allow mock providers with APP_ENV=production (prefer APP_ENV=demo)
ALLOW_DEMO_PROVIDERS_IN_PRODUCTION=

# ── Database ─────────────────────────────────────────────────────────────
# Empty = embedded demo database (data kept in ~/.khairiyat/demo-data).
# Production: Supabase pooler connection string (transaction mode, port 6543).
DATABASE_URL=
# Don't set this yourself: Netlify sets NETLIFY_DB_URL on sites with a Netlify
# Database (used when DATABASE_URL is empty; Netlify applies the migrations).

# ── Our own secrets (required in production and demo; demo values are used locally) ─
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts sensitive fields such as health notes. Losing it = losing that data.
DATA_ENCRYPTION_KEY=
# Signs login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Protects the scheduler tick endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=
# Comma-separated emails that get the admin panel
ADMIN_EMAILS=

# ── Google sign-in (optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Voice: ElevenLabs Agents ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# twilio (phone number imported from Twilio) | sip_trunk (Plivo/Ozonetel/Tata via SIP)
ELEVENLABS_TELEPHONY=twilio
# Optional: regional host, e.g. https://api.in.residency.elevenlabs.io (India residency)
ELEVENLABS_API_BASE=
# Optional: voices from your ElevenLabs voice library for Roshni (female) and Aman (male)
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=
# Optional: workspace webhook id; npm run agent:sync attaches it to the agent
ELEVENLABS_POST_CALL_WEBHOOK_ID=
# Tip: with ONLY ELEVENLABS_API_KEY + ELEVENLABS_AGENT_ID set, phone calls stay
# simulated but you can talk to the assistant in your browser (demo room).

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
# e.g. Khairiyat <hello@yourdomain.in>  (needs a verified domain)
EMAIL_FROM=

# ── Payments (Razorpay) ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Monitoring (optional) ────────────────────────────────────────────────
SENTRY_DSN=
# Healthchecks.io ping URL: alerts you if the scheduler stops ticking
HEALTHCHECKS_PING_URL=

# ── Support (optional) ───────────────────────────────────────────────────
# Your WhatsApp support number in E.164, e.g. +9198XXXXXXXX
SUPPORT_WHATSAPP_NUMBER=

# ── Demo mode (optional; only when no DATABASE_URL) ─────────────────────
# Where the embedded demo database lives (default ~/.khairiyat/demo-data). memory:// = throwaway
PGLITE_DATA_DIR=
# Days of history to create on first start (default 21)
DEMO_SEED_DAYS=
# 0 = don't create demo families on first start
DEMO_AUTO_SEED=
# How often the in-app demo scheduler ticks, in ms (default 5000). DISABLE_LOCAL_TICKER=1 turns it off
LOCAL_TICK_MS=
DISABLE_LOCAL_TICKER=
